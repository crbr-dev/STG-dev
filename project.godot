; ESP Ra.De. HD Chapters. Godot 4.7.
config_version=5

[application]
config/name="ESP Ra.De. — HD Chapters"
config/version="1.0.0"
config/icon="res://assets/ui/clover.svg"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Five playable chapters with original background music."

[display]
window/size/viewport_width=960
window/size/viewport_height=960
window/size/window_width_override=900
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/resizable=true

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.025, 0.03, 0.04, 1)

[audio]
driver/enable_input=false

[debug]
gdscript/warnings/untyped_declaration=0
gdscript/warnings/integer_division=0
